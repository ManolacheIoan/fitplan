# PostgreSQL connection string. Neon gives "postgresql://...?...sslmode=require"; the
# driver prefix is added automatically.
DATABASE_URL=postgresql://fitplan:fitplan@localhost:5433/fitplan
# Long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# Used to derive CSRF tokens. Never commit the real value.
SECRET_KEY=change-me
# Browser origins allowed to call the API (comma-separated). In production: the Netlify URL.
ALLOWED_ORIGINS=http://localhost:3000
# Must be true in production (HTTPS). Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
SESSION_TTL_DAYS=14
# Login/registration attempts allowed per IP and per email within the window (seconds).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
# Used to group workouts into local calendar weeks.
APP_TIMEZONE=Europe/Bucharest
# External food database: none | open_food_facts (mock is for tests). See
# app/nutrition/food_sources/LICENSING.md for licence and attribution rules.
FOOD_SOURCE=open_food_facts
# Open Food Facts asks every app to identify itself: "AppName/Version (contact email)".
OFF_USER_AGENT=FitPlan/0.1 (contact@example.com)
# V2 feature flag: free-text meal parsing. Not implemented in V1; keep false.
FEATURE_AI_MEAL_PARSING=false
# Bearer token for the scheduled guest cleanup (POST /api/v1/internal/purge-guests).
# Empty disables the endpoint. Use >= 32 random characters, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MAINTENANCE_TOKEN=
